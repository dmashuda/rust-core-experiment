common --enable_platform_specific_config

# Aspect's rulesets report ruleset/version usage home on every build.
common --repo_env=DO_NOT_TRACK=1

# Only the failing test's output, rather than a pointer to a log file.
test --test_output=errors

# The formatting the Rust here is committed in. Check with
#   bazel build --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect \
#       --output_groups=rustfmt_checks //core/... //bindings/... //tools/...
# and apply with `bazel run @rules_rust//tools/rustfmt`.
common --@rules_rust//rust/settings:rustfmt.toml=//:.rustfmt.toml

# Pick up per-user overrides last.
try-import %workspace%/user.bazelrc

# Optimised builds (wasm drops from ~240 KB to ~125 KB, and the JS is minified).
build:release --compilation_mode=opt

# Required when a non-Rust linker (Swift/clang via rules_apple, or the
# Android NDK) links Rust rlibs: rules_rust supplies the allocator shim
# (__rust_alloc, __rust_no_alloc_shim_is_unstable...) that rustc would
# normally emit only when it links the final binary itself.
common --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols=True

# One macOS deployment target for everything built for the host (tools, tests).
# Without this the Apple CC toolchain targets the *running* OS (27.0) while
# rustc assumes 11.0, and every Rust link warns
# "overriding '-mmacosx-version-min=11.0.0' with '-target arm64-apple-macosx27.0'".
common --macos_minimum_os=14.0
common --host_macos_minimum_os=14.0
common --action_env=MACOSX_DEPLOYMENT_TARGET=14.0
common --host_action_env=MACOSX_DEPLOYMENT_TARGET=14.0

# iOS targets. rules_apple defaults to the simulator matching the host CPU.
build:ios_sim --ios_multi_cpus=sim_arm64
build:ios_device --ios_multi_cpus=arm64

# Android: which ABIs android_binary builds native code (our Rust) for.
# Must be repo-qualified (@@//...): rules_android's split transition turns the
# label back into a string, and a bare //platforms:... then resolves inside
# @rules_android ("no such package '@@rules_android+//platforms'").
common --android_platforms=@@//platforms:arm64-v8a

# rules_android builds its own Java tools from source and they use Java 17
# features (Bazel's default -source is 11). Same flags as rules_android's
# examples/basicapp/.bazelrc.
common --java_language_version=17
common --java_runtime_version=17
common --tool_java_language_version=17
common --tool_java_runtime_version=17
