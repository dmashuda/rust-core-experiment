"""JVM and Kotlin: the UniFFI Kotlin bindings, and the foundation for Android.

The Android-only half of Maven lives in android.MODULE.bazel, because its JNA
artifact must not share a classpath with the one below.
"""

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_jvm_external", version = "7.2")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # UniFFI's Kotlin bindings call into Rust through JNA.
        # (On Android use the "net.java.dev.jna:jna:5.17.0@aar" packaging,
        # which carries libjnidispatch.so for each ABI.)
        "net.java.dev.jna:jna:5.17.0",
        "junit:junit:4.13.2",
        # The Kotlin driver of the shared flows reads flows.json.
        "com.google.code.gson:gson:2.13.2",
        # The Android renderer's test (//apps/android:RendererTest) runs the
        # real Views on the host JVM. Robolectric supplies the Android
        # framework from the android-all jar for one SDK level, fetched here
        # rather than by Robolectric at test time; 4.17 expects exactly this
        # build for SDK 34 (see DefaultSdkProvider in its jar). SDK 35 and up
        # need a Java 21 runtime, and .bazelrc pins 17 for rules_android.
        "org.robolectric:robolectric:4.17",
        "org.robolectric:android-all-instrumented:14-robolectric-10818077-i7",
    ],
    # Pinned (versions + sha256). After changing artifacts:
    # REPIN=1 bazel run @maven//:pin
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
        # Robolectric's androidx.test dependencies.
        "https://maven.google.com",
    ],
)
use_repo(maven, "maven")
