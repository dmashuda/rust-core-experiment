"""The web front end: Rust to wasm, then TypeScript and esbuild around it."""

# Ships wasm-bindgen's CLI *and* a version-matched wasm-bindgen crate at
# @rules_rust_wasm_bindgen//3rdparty:wasm_bindgen.
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")

bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "aspect_rules_esbuild", version = "0.27.1")
bazel_dep(name = "rules_nodejs", version = "6.7.7")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.22.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = ["//:pnpm-workspace.yaml"],
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version_from = "//:package.json")
use_repo(rules_ts_ext, "npm_typescript")
