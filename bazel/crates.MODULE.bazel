"""Third-party crates (crate_universe, no Cargo.toml: the specs live here).

Two separate repos so the bindgen CLI's heavy deps (clap, askama, goblin...)
never get feature-unified into the library that ships inside the apps.
UniFFI's runtime and bindgen must be the *same* version: the bindgen reads
metadata the runtime macros embed in the compiled library.
"""

UNIFFI_VERSION = "=0.32.2"

# Every triple some front end compiles Rust for (plus Linux for CI).
CRATE_TRIPLES = [
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
    "aarch64-apple-ios",
    "aarch64-apple-ios-sim",
    "aarch64-linux-android",
    "wasm32-unknown-unknown",
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu",
]

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# Runtime deps linked into app binaries.
crate.spec(
    default_features = False,
    package = "uniffi",
    repositories = ["crates"],
    version = UNIFFI_VERSION,
)
crate.from_specs(
    name = "crates",
    supported_platform_triples = CRATE_TRIPLES,
)

# Build-time tools (run on the exec platform only).
# default_features = False drops `cargo-metadata`, so the bindgen never tries
# to shell out to `cargo metadata` (impossible inside a Bazel sandbox).
crate.spec(
    default_features = False,
    features = ["cli"],
    package = "uniffi",
    repositories = ["tool_crates"],
    version = UNIFFI_VERSION,
)
crate.from_specs(
    name = "tool_crates",
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates", "tool_crates")
