"""Hermetic C/C++ toolchain on Linux (hermetic-llvm, module "llvm").

Prebuilt clang/lld plus glibc, libc++, compiler-rt and libunwind built from
source in Bazel: a Linux host needs no gcc, binutils, libc headers or python.
It also links every Rust binary. Registered for Linux exec/target only; on
macOS, apple_support's Xcode toolchain stays in charge (Apple targets need
Xcode regardless), and Android uses the NDK.
"""

bazel_dep(name = "llvm", version = "0.8.25")

llvm_toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchain.exec(arch = "aarch64", os = "linux")
llvm_toolchain.exec(arch = "x86_64", os = "linux")
llvm_toolchain.target(arch = "aarch64", os = "linux")
llvm_toolchain.target(arch = "x86_64", os = "linux")
use_repo(llvm_toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

# Diamond fix: llvm needs rules_go 0.62, which lifts gazelle to 0.51.3, whose
# Go tools need Go >= 1.24.12. rules_android (which builds Go tools) pins its
# Go SDK to 1.22.4. The root module's SDK wins, so pin a newer one here.
bazel_dep(name = "rules_go", version = "0.62.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.0")
