load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("@rules_swift//swift:swift.bzl", "swift_interop_hint", "swift_library")
load("//tools/android:defs.bzl", "ANDROID_TARGET_COMPATIBLE_WITH")
load("//tools/apple:defs.bzl", "APPLE_TARGET_COMPATIBLE_WITH")

# The crate is compiled twice -- as an rlib for Apple linking, and as a
# cdylib for the bindgen, the JVM and Android -- so the two targets share one
# dep list rather than drifting apart.
#
# calc_ui_uniffi is calc_ui with its `uniffi` feature on: the records the
# renderers draw carry UniFFI derives, so this crate passes them through
# instead of mirroring them. The bindgen therefore finds two components in
# the library, calc_ui and calc_ffi, and generates a file for each.
CALC_FFI_DEPS = [
    "//core/calc_history_sqlite",
    "//core/calc_ui:calc_ui_uniffi",
    "@crates//:uniffi",
]

rust_library(
    name = "calc_ffi",
    srcs = ["src/lib.rs"],
    # Stub manifest read by UniFFI's proc-macros; see the comment inside it.
    compile_data = ["Cargo.toml"],
    deps = CALC_FFI_DEPS,
)

# Run uniffi-bindgen-swift in library mode against the compiled cdylib. The
# cdylib rather than the rlib because the metadata for the records lives in
# calc_ui, and only the final link brings every crate's metadata together in
# one file. It is listed in `tools`, so it is built for the *exec* platform:
# the generated Swift/C is platform-independent, so one generation serves
# macOS, iOS device and iOS simulator builds alike.
#
# One .swift and one .h per component. uniffi.toml points calc_ui's Swift at
# the same Clang module as calc_ffi's, so both headers go in one cc_library.
genrule(
    name = "calc_ffi_swift_gen",
    srcs = ["uniffi.toml"],
    outs = [
        "calc_ffi.swift",
        "calc_ffiFFI.h",
        "calc_ui.swift",
        "calc_uiFFI.h",
    ],
    cmd = """
        $(execpath //tools/uniffi:uniffi_bindgen_swift) \
            --swift-sources --headers \
            --config $(execpath uniffi.toml) \
            $(execpath :calc_ffi_shared) $(RULEDIR)
    """,
    tools = [
        ":calc_ffi_shared",
        "//tools/uniffi:uniffi_bindgen_swift",
    ],
)

# Kotlin bindings (for Android, and for a host JVM test). Same exec-config
# trick as the Swift genrule above. One file per component, each in the
# package uniffi.toml gives it.
genrule(
    name = "calc_ffi_kotlin_gen",
    srcs = ["uniffi.toml"],
    outs = [
        "dev/mashuda/calc/calc_ffi.kt",
        "dev/mashuda/calc/ui/calc_ui.kt",
    ],
    cmd = """
        $(execpath //tools/uniffi:uniffi_bindgen) generate --library \
            --language kotlin --no-format \
            --config $(execpath uniffi.toml) \
            --out-dir $(RULEDIR) \
            $(execpath :calc_ffi_shared)
    """,
    tools = [
        ":calc_ffi_shared",
        "//tools/uniffi:uniffi_bindgen",
    ],
)

# The C half: generated headers + the Rust code itself. rust_library provides
# CcInfo, so linking it here pulls the Rust objects (and std) into whatever
# Apple binary ends up depending on this. The two headers share UniFFI's
# common declarations behind an include guard, so one module holds both.
cc_library(
    name = "calc_ffiFFI",
    hdrs = [
        "calc_ffiFFI.h",
        "calc_uiFFI.h",
    ],
    aspect_hints = [":calc_ffiFFI_interop"],
    deps = [":calc_ffi"],
)

# The generated Swift does `import calc_ffiFFI`; this names the Clang module.
swift_interop_hint(
    name = "calc_ffiFFI_interop",
    module_name = "calc_ffiFFI",
)

# The Swift half: what app code imports (`import CalcFFI`). Both generated
# files go in this one module: the calc_ffi file uses the calc_ui records
# by bare name, which is how UniFFI's Swift expects to be compiled.
swift_library(
    name = "CalcFFI",
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    srcs = [
        "calc_ffi.swift",
        "calc_ui.swift",
    ],
    module_name = "CalcFFI",
    visibility = ["//visibility:public"],
    deps = [":calc_ffiFFI"],
)

# Swift calling into Rust. macos_unit_test (rules_apple) rather than
# swift_test (rules_swift): swift_test hardcodes rpaths to xcode-select's
# symlinks (/var/db/xcode_select_link...), which do not exist unless someone
# has run `sudo xcode-select -s`; macos_unit_test runs via `xcrun xctest`.
swift_library(
    name = "CalcFFITestsLib",
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    testonly = True,
    srcs = ["tests/CalcFFITests.swift"],
    deps = [":CalcFFI"],
)

macos_unit_test(
    name = "CalcFFITests",
    size = "small",
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    minimum_os_version = "14.0",
    deps = [":CalcFFITestsLib"],
)

# Kotlin bindings compiled for the JVM. An Android app would use
# kt_android_library with the same srcs plus the JNA AAR.
kt_jvm_library(
    name = "calc_ffi_kt",
    srcs = [":calc_ffi_kotlin_gen"],
    visibility = ["//visibility:public"],
    deps = ["@maven//:net_java_dev_jna_jna"],
)

# The crate as a cdylib (lib<crate_name>.so/.dylib, no hash suffix). Built
# for the exec platform it is what the bindgens read; built for the host it
# backs the JVM test; built under android_binary's split transition it
# becomes the Android libcalc_ffi.so.
rust_shared_library(
    name = "calc_ffi_shared",
    srcs = ["src/lib.rs"],
    compile_data = ["Cargo.toml"],
    crate_name = "calc_ffi",
    deps = CALC_FFI_DEPS + select({
        # hermetic-llvm replaces libgcc_s with an empty stub and links
        # libunwind into *executables* only. A .so loaded by a non-Rust
        # process (the JVM) must carry its own unwinder, or loading fails
        # with "undefined symbol: _Unwind_Resume".
        "@platforms//os:linux": [":libunwind_static"],
        "//conditions:default": [],
    }),
)

# LLVM's libunwind archive (built from source by hermetic-llvm), wrapped so
# rules_rust accepts it as a C dependency.
cc_import(
    name = "libunwind_static",
    static_library = "@llvm//runtimes/libunwind:libunwind.static",
)

# Kotlin -> JNA -> Rust on the host JVM: proves the Android binding path
# without needing the Android SDK/NDK.
kt_jvm_test(
    name = "CalcFfiKotlinTest",
    size = "small",
    srcs = ["tests/CalcFfiKotlinTest.kt"],
    data = [":calc_ffi_shared"],
    env = {"CALC_FFI_LIB": "$(rootpath :calc_ffi_shared)"},
    test_class = "dev.mashuda.calc.CalcFfiKotlinTest",
    deps = [
        ":calc_ffi_kt",
        "@maven//:junit_junit",
    ],
)

# The same generated Kotlin, compiled for Android against JNA's AAR. (The
# non-`android = true` template works on Android: it probes for
# java.lang.ref.Cleaner at runtime and falls back to JNA's cleaner, so no
# androidx dependency is needed.)
kt_android_library(
    name = "calc_ffi_android_kt",
    srcs = [":calc_ffi_kotlin_gen"],
    custom_package = "dev.mashuda.calc",
    target_compatible_with = ANDROID_TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
    deps = ["@maven_android//:net_java_dev_jna_jna"],
)

# The Rust code for Android: a real cdylib (libcalc_ffi.so, linked by rustc
# with the NDK clang), imported as a prebuilt shared library so
# android_binary copies it into lib/<abi>/ unchanged.
#
# Why not pass the rust_library's CcInfo like on Apple? rules_android only
# links static deps it believes contain code, and it decides that from
# LibraryToLink.objects. rules_rust provides the rlib as an opaque generated
# archive with no objects listed, which rules_android classifies as an
# "empty archive" and silently drops, leaving no Rust in the APK.
cc_import(
    name = "calc_ffi_android_native",
    shared_library = ":calc_ffi_shared",
    visibility = ["//visibility:public"],
)
