load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("@rules_swift//swift:swift.bzl", "swift_interop_hint", "swift_library")

rust_library(
    name = "calc_ffi",
    srcs = ["src/lib.rs"],
    # Stub manifest read by UniFFI's proc-macros; see the comment inside it.
    compile_data = ["Cargo.toml"],
    deps = [
        "//core/calc_ui",
        "@crates//:uniffi",
    ],
)

# Run uniffi-bindgen-swift in library mode against the compiled rlib.
# The rlib is listed in `tools`, so it is built for the *exec* platform: the
# generated Swift/C is platform-independent, so one generation serves macOS,
# iOS device and iOS simulator builds alike.
genrule(
    name = "calc_ffi_swift_gen",
    outs = [
        "calc_ffi.swift",
        "calc_ffiFFI.h",
    ],
    cmd = """
        $(execpath //tools/uniffi:uniffi_bindgen_swift) \
            --swift-sources --headers \
            $(execpath :calc_ffi) $(RULEDIR)
    """,
    tools = [
        ":calc_ffi",
        "//tools/uniffi:uniffi_bindgen_swift",
    ],
)

# Kotlin bindings (for Android, and for a host JVM test). Same exec-config
# trick as the Swift genrule above.
genrule(
    name = "calc_ffi_kotlin_gen",
    srcs = ["uniffi.toml"],
    outs = ["dev/mashuda/calc/calc_ffi.kt"],
    cmd = """
        $(execpath //tools/uniffi:uniffi_bindgen) generate --library \
            --language kotlin --no-format \
            --config $(execpath uniffi.toml) \
            --out-dir $(RULEDIR) \
            $(execpath :calc_ffi)
    """,
    tools = [
        ":calc_ffi",
        "//tools/uniffi:uniffi_bindgen",
    ],
)

# The C half: generated header + the Rust code itself. rust_library provides
# CcInfo, so linking it here pulls the Rust objects (and std) into whatever
# Apple binary ends up depending on this.
cc_library(
    name = "calc_ffiFFI",
    hdrs = ["calc_ffiFFI.h"],
    aspect_hints = [":calc_ffiFFI_interop"],
    deps = [":calc_ffi"],
)

# The generated Swift does `import calc_ffiFFI`; this names the Clang module.
swift_interop_hint(
    name = "calc_ffiFFI_interop",
    module_name = "calc_ffiFFI",
)

# The Swift half: what app code imports (`import CalcFFI`).
swift_library(
    name = "CalcFFI",
    srcs = ["calc_ffi.swift"],
    module_name = "CalcFFI",
    visibility = ["//visibility:public"],
    deps = [":calc_ffiFFI"],
)

# Swift calling into Rust. macos_unit_test (rules_apple) rather than
# swift_test (rules_swift): swift_test hardcodes rpaths to xcode-select's
# symlinks (/var/db/xcode_select_link...), which do not exist unless someone
# has run `sudo xcode-select -s`; macos_unit_test runs via `xcrun xctest`.
swift_library(
    name = "CalcFFITestsLib",
    testonly = True,
    srcs = ["tests/CalcFFITests.swift"],
    deps = [":CalcFFI"],
)

macos_unit_test(
    name = "CalcFFITests",
    minimum_os_version = "14.0",
    deps = [":CalcFFITestsLib"],
)

# Kotlin bindings compiled for the JVM. An Android app would use
# kt_android_library with the same srcs plus the JNA AAR.
kt_jvm_library(
    name = "calc_ffi_kt",
    srcs = [":calc_ffi_kotlin_gen"],
    visibility = ["//visibility:public"],
    deps = ["@maven//:net_java_dev_jna_jna"],
)

# The crate as a cdylib (lib<crate_name>.so/.dylib, no hash suffix). Built
# for the host it backs the JVM test; built under android_binary's split
# transition it becomes the Android libcalc_ffi.so.
rust_shared_library(
    name = "calc_ffi_shared",
    srcs = ["src/lib.rs"],
    compile_data = ["Cargo.toml"],
    crate_name = "calc_ffi",
    deps = [
        "//core/calc_ui",
        "@crates//:uniffi",
    ],
)

# Kotlin -> JNA -> Rust on the host JVM: proves the Android binding path
# without needing the Android SDK/NDK.
kt_jvm_test(
    name = "CalcFfiKotlinTest",
    srcs = ["tests/CalcFfiKotlinTest.kt"],
    data = [":calc_ffi_shared"],
    env = {"CALC_FFI_LIB": "$(rootpath :calc_ffi_shared)"},
    test_class = "dev.mashuda.calc.CalcFfiKotlinTest",
    deps = [
        ":calc_ffi_kt",
        "@maven//:junit_junit",
    ],
)

# The same generated Kotlin, compiled for Android against JNA's AAR. (The
# non-`android = true` template works on Android: it probes for
# java.lang.ref.Cleaner at runtime and falls back to JNA's cleaner, so no
# androidx dependency is needed.)
kt_android_library(
    name = "calc_ffi_android_kt",
    srcs = [":calc_ffi_kotlin_gen"],
    custom_package = "dev.mashuda.calc",
    visibility = ["//visibility:public"],
    deps = ["@maven_android//:net_java_dev_jna_jna"],
)

# The Rust code for Android: a real cdylib (libcalc_ffi.so, linked by rustc
# with the NDK clang), imported as a prebuilt shared library so
# android_binary copies it into lib/<abi>/ unchanged.
#
# Why not pass the rust_library's CcInfo like on Apple? rules_android only
# links static deps it believes contain code, and it decides that from
# LibraryToLink.objects. rules_rust provides the rlib as an opaque generated
# archive with no objects listed, which rules_android classifies as an
# "empty archive" and silently drops, leaving no Rust in the APK.
cc_import(
    name = "calc_ffi_android_native",
    shared_library = ":calc_ffi_shared",
    visibility = ["//visibility:public"],
)
