load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Platform-independent UI state machine: keypad layout, input handling,
# display/error state and history formatting. Front ends only render the
# ViewModel and feed key presses back in.
#
# The crate is built three ways from the same sources. The plain target is
# FFI-free; the other two turn on a crate feature that adds the UniFFI or
# wasm-bindgen derives to the types a renderer sees, so each binding crate
# hands those types across its boundary as they are instead of mirroring
# them. A binary links exactly one of the three (they share a crate name).
CALC_UI_SRCS = glob(["src/**/*.rs"])

rust_library(
    name = "calc_ui",
    srcs = CALC_UI_SRCS,
    visibility = ["//visibility:public"],
    deps = ["//core/calc_core"],
)

rust_test(
    name = "calc_ui_test",
    size = "small",
    crate = ":calc_ui",
)

# For //bindings/uniffi. The stub Cargo.toml is read by UniFFI's proc-macros;
# see the comment inside it.
rust_library(
    name = "calc_ui_uniffi",
    srcs = CALC_UI_SRCS,
    compile_data = ["Cargo.toml"],
    crate_features = ["uniffi"],
    crate_name = "calc_ui",
    visibility = ["//bindings:__subpackages__"],
    deps = [
        "//core/calc_core",
        "@crates//:uniffi",
    ],
)

# For //bindings/wasm. wasm32 only: wasm-bindgen's derives have nothing to
# attach to on a native target.
rust_library(
    name = "calc_ui_wasm",
    srcs = CALC_UI_SRCS,
    crate_features = ["wasm"],
    crate_name = "calc_ui",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    visibility = ["//bindings:__subpackages__"],
    deps = [
        "//core/calc_core",
        "@crates//:wasm-bindgen",
    ],
)
