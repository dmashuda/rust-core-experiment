"""Rust-core monorepo: one Rust core, many native front ends, all built by Bazel.

The toolchains themselves live in bazel/*.MODULE.bazel, pulled in by the
include() calls at the bottom. Two kinds of ordering are load-bearing here, so
neither the dependencies above nor the includes below are free to be
rearranged:

  * apple_support is depended on before rules_cc, because Bazel takes the
    first registered C/C++ toolchain and only apple_support's can target iOS
    and macOS.
  * register_toolchains() precedence follows the order the calls are reached,
    which across the includes means Rust, then LLVM, then the Android SDK and
    NDK.
"""

module(name = "rust_core_experiment")

# apple_support must come before rules_cc: Bazel picks the first registered
# C/C++ toolchain, and only apple_support's can target iOS/macOS properly.
bazel_dep(name = "apple_support", version = "2.10.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_apple", version = "5.3.1")

# Order matters: see the docstring above.
include("//bazel:rust.MODULE.bazel")
include("//bazel:cc_linux.MODULE.bazel")
include("//bazel:crates.MODULE.bazel")
include("//bazel:web.MODULE.bazel")
include("//bazel:jvm.MODULE.bazel")
include("//bazel:android.MODULE.bazel")
