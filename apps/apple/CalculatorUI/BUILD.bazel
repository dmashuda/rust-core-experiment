load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/apple:defs.bzl", "APPLE_TARGET_COMPATIBLE_WITH")

# SwiftUI views + view model shared by the macOS and iOS apps. Depends only on
# the UniFFI Swift module; the Rust code arrives transitively via CcInfo.
swift_library(
    name = "CalculatorUI",
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    srcs = glob(["Sources/*.swift"]),
    module_name = "CalculatorUI",
    visibility = ["//apps:__subpackages__"],
    deps = ["//bindings/uniffi:CalcFFI"],
)

swift_library(
    name = "CalculatorUITestsLib",
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    testonly = True,
    srcs = glob(["tests/*.swift"]),
    deps = [":CalculatorUI"],
)

macos_unit_test(
    name = "CalculatorUITests",
    # Mostly xctest start-up: ~23s here, but over 60s on a GitHub runner, so
    # this keeps the 300s "medium" timeout. Bazel warns that the timeout is
    # larger than the observed runtime; that warning is wrong for this test,
    # which is exactly how CI caught it (TIMEOUT in 60.2s).
    size = "medium",
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    minimum_os_version = "14.0",
    deps = [":CalculatorUITestsLib"],
)
