load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "CalculatorAppLib",
    srcs = ["CalculatorApp.swift"],
    deps = ["//apps/apple/CalculatorUI"],
)

# Simulator:  bazel build --config=ios_sim //apps/ios:CalculatorIOS   (the default on Apple Silicon)
# Device:     bazel build --config=ios_device //apps/ios:CalculatorIOS
#             fails at analysis until `provisioning_profile` is set; rules_apple
#             refuses to produce an unsigned device build.
ios_application(
    name = "CalculatorIOS",
    bundle_id = "dev.mashuda.rustcalc",
    bundle_name = "RustCalculator",
    families = ["iphone", "ipad"],
    infoplists = ["Info.plist"],
    minimum_os_version = "17.0",
    deps = [":CalculatorAppLib"],
)
