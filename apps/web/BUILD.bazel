load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")

# Type-check only; esbuild does the transpiling and bundling below.
ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]),
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = ["//bindings/wasm:calc_wasm_js"],
)

# Minifying a fastbuild bundle only makes it unreadable; --config=release
# (compilation_mode=opt) is what ships.
config_setting(
    name = "optimized",
    values = {"compilation_mode": "opt"},
)

MINIFY = select({
    ":optimized": True,
    "//conditions:default": False,
})

# The page: DOM only. It never loads the wasm, so this bundle stays tiny.
esbuild(
    name = "bundle",
    srcs = glob(["src/**/*.ts"]),
    entry_point = "src/main.ts",
    format = "esm",
    minify = MINIFY,
    output = "main.js",
    target = "es2022",
    deps = ["//bindings/wasm:calc_wasm_js"],
)

# The calculator: wasm plus its SQLite history, in a dedicated worker because
# the OPFS VFS needs createSyncAccessHandle. Bundled separately because
# `new Worker(url)` loads a file of its own.
esbuild(
    name = "worker_bundle",
    srcs = glob(["src/**/*.ts"]),
    entry_point = "src/worker.ts",
    format = "esm",
    minify = MINIFY,
    output = "worker.js",
    target = "es2022",
    deps = ["//bindings/wasm:calc_wasm_js"],
)

# The deployable site: everything flattened into one directory.
copy_to_directory(
    name = "site",
    srcs = [
        "index.html",
        "style.css",
        ":bundle",
        ":worker_bundle",
        "//bindings/wasm:calc_wasm_bindgen",
    ],
    # Only the .wasm is needed at runtime; calc.js is already inside worker.js.
    exclude_srcs_patterns = [
        "**/*.d.ts",
        "**/calc.js",
        "**/snippets/**",
        "**/*.map",
    ],
    replace_prefixes = {
        "apps/web/": "",
        "bindings/wasm/calc_wasm_bindgen/": "",
    },
    visibility = ["//visibility:public"],
)

# Runs the bundled renderer against a minimal DOM (see the test file).
js_test(
    name = "renderer_test",
    size = "small",
    data = [":site"],
    entry_point = "main.test.mjs",
)

# `bazel run //apps/web:serve` then open http://localhost:8080
js_binary(
    name = "serve",
    args = ["$(rootpath :site)"],
    data = [":site"],
    entry_point = "//tools/serve",
)
